# Reference only: export these variables in your shell; .env is not auto-loaded.
# Same Vertex model as bibs. Uses Google Application Default Credentials.
GERRY_MODEL=vertex_ai/gemini-3.5-flash-lite
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_CLOUD_PROJECT=your-project-id
# GEMINI_API_KEY is only required for an API-key model override, not Vertex.

# Use LiteLLM's bundled cost map rather than fetching one during startup.
LITELLM_LOCAL_MODEL_COST_MAP=True

# Optional research ceilings (positive integers). Defaults shown.
# GERRY_MAX_LEAD_TURNS=8
# GERRY_MAX_RESEARCH_ROUNDS=3
# GERRY_MAX_ARTICLE_READS=30
# GERRY_MAX_CONCURRENT_RESEARCHERS=2
# GERRY_REQUEST_DEADLINE_SECONDS=300
# GERRY_MAX_RETRIES=2
# GERRY_MAX_SEARCH_CALLS=20
# GERRY_MAX_MODEL_CALLS=40
# GERRY_MAX_OUTPUT_TOKENS=4096
